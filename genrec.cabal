cabal-version:      3.0
name:               genrec
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             Satoshi Takimoto
maintainer:         wasabi.nvim.st@gmail.com
-- copyright:
build-type:         Simple
-- extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
  ghc-options:
    -Wall
    -fno-warn-unused-matches
    -fno-warn-unused-imports
    -fno-warn-unused-local-binds

library
    import:           warnings
    exposed-modules:  GenRec.Class
                    , GenRec.Direct
                    , GenRec.Fueled
                    , GenRec.Total
    other-modules:    GenRec.Example
    build-depends:    base >=4.21 && <5
    hs-source-dirs:   lib
    default-language: GHC2024

    ghc-options:
      -- agda2hs generates many (safe) incomplete patterns
      -fno-warn-incomplete-patterns
      -fno-warn-name-shadowing
      -ddump-simpl
      -dsuppress-all
      -dno-suppress-type-signatures
      -ddump-to-file
